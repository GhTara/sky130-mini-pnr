# One-bit full adder built from nine NAND2 gates for the device placer.
# As in full_adder.bench, s is the sum bit and cout is the carry.
INPUT(a)
INPUT(b)
INPUT(cin)
OUTPUT(s)
OUTPUT(cout)
n1 = NAND(a, b)
n2 = NAND(a, n1)
n3 = NAND(b, n1)
p = NAND(n2, n3)
n5 = NAND(p, cin)
n6 = NAND(p, n5)
n7 = NAND(cin, n5)
s = NAND(n6, n7)
cout = NAND(n5, n1)
